// I-deploy gamit ang: firebase deploy --only firestore:rules
// Draft pa ito; aayusin natin ang orders rules kapag tapos na ang checkout.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validProduct(p) {
      return p.name is string && p.name.size() > 0 && p.name.size() <= 120
        && p.price is number && p.price >= 0
        && p.stock is int && p.stock >= 0
        && p.active is bool;
    }

    // Products: lahat makakabasa ng active products; admin lang ang makaka-edit.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Orders: customers makakapag-order, pero hindi nila mababasa o mababago pagkatapos.
    match /orders/{orderId} {
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number;
      allow read, update, delete: if isAdmin();
    }

    // Admins: sa Firebase Console lang dinadagdag, hindi sa website.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
